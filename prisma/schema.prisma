// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum ProductBadge {
  NEW
  BEST_SELLER
  LIMITED
  TRENDING
  COLLECTOR_PICK
}

enum LoyaltyTransactionType {
  EARNED
  REDEEMED
  ADJUSTED
  EXPIRED
}

model User {
  id               String               @id @default(uuid())
  name             String?
  email            String               @unique
  emailVerified    DateTime?
  image            String?
  avatar           String?
  password         String?
  phone            String?
  provider         String?
  role             Role                 @default(CUSTOMER)
  lastLogin        DateTime?
  isBlocked        Boolean              @default(false)
  marketingConsent Boolean              @default(false)
  loyaltyPoints    Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  
  accounts         Account[]
  sessions         Session[]
  orders           Order[]
  reviews          Review[]
  wishlists        Wishlist[]
  addresses        Address[]
  loyaltyHistory   LoyaltyTransaction[]

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Address {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String   @default("Home") // Home, Office, Gift, etc.
  name           String
  street         String
  city           String
  state          String?
  zip            String
  country        String   @default("India")
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("addresses")
}

model Product {
  id                  String         @id @default(uuid())
  slug                String         @unique
  title               String
  film                String
  year                Int
  director            String
  cast                String[]
  collectionName      String
  collection          Collection     @relation(fields: [collectionName], references: [name])
  genre               String
  price               Float
  costPrice           Float          @default(0.0)
  inventory           Int            @default(0)
  lowStockThreshold   Int            @default(5)
  isPreorder          Boolean        @default(false)
  isSoldOut           Boolean        @default(false)
  limitedEditionCount Int?
  
  // Polacraft v1.1 Limited Edition & Badge Fields
  badge               ProductBadge?
  isLimitedEdition    Boolean        @default(false)
  editionTotal        Int?           @default(100)
  editionSold         Int?           @default(0)

  // Custom flags
  featured            Boolean        @default(false)
  newArrival          Boolean        @default(false)
  bestSeller          Boolean        @default(false)
  isHero              Boolean        @default(false)
  heroOrder           Int            @default(0)
  featuredOrder       Int            @default(0)
  averageRating       Float          @default(0.0)
  reviewCount         Int            @default(0)

  // Palette settings
  primaryColor        String
  accentColor         String
  bgColor             String
  textColor           String

  gsm                 Int            @default(250)
  finish              String         @default("Ultra-Matte Giclée")
  paperType           String         @default("Fine Art Cotton Archival")
  
  tagline             String
  story               String         @db.Text
  designNotes         String         @db.Text

  // Polacraft v1.2 AI Product Assistant Fields
  aiGenerated         Boolean?       @default(false)
  aiGeneratedAt       DateTime?
  aiReviewedByAdmin   Boolean?       @default(false)
  aiConfidence        Float?
  aiKeywords          String[]
  imageHash           String?
  orientation         String?
  aspectRatio         Float?
  copyrightType       String?
  isPrintSuitable     Boolean?       @default(true)
  qualityWarnings     String[]
  subCollectionId     String?
  subCollection       SubCollection? @relation(fields: [subCollectionId], references: [id], onDelete: SetNull)

  images              ProductImage[]
  reviews             Review[]
  orderItems          OrderItem[]
  wishlistedBy        Wishlist[]
  
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  publishedAt         DateTime?

  @@index([collectionName])
  @@index([subCollectionId])
  @@index([createdAt])
  @@index([featured])
  @@map("products")
}

model ProductImage {
  id        String    @id @default(uuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  publicId  String?
  alt       String
  sortOrder Int       @default(0)
  type      ImageType @default(GALLERY) // HERO, GALLERY, WALL_MOCKUP, PACKAGING, DETAIL, MOBILE

  @@map("product_images")
}

enum ImageType {
  HERO
  GALLERY
  WALL_MOCKUP
  PACKAGING
  DETAIL
  MOBILE
}

model Collection {
  id             String          @id @default(uuid())
  name           String          @unique
  slug           String?
  description    String?         @db.Text
  coverImage     String?
  parentId       String?
  parent         Collection?     @relation("LegacySubCollections", fields: [parentId], references: [id], onDelete: SetNull)
  legacySubCols  Collection[]    @relation("LegacySubCollections")
  subCollections SubCollection[]
  products       Product[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt

  @@map("collections")
}

model SubCollection {
  id           String     @id @default(uuid())
  name         String
  slug         String     @unique
  description  String?    @db.Text
  coverImage   String?
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  products     Product[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([collectionId, name])
  @@index([collectionId])
  @@index([slug])
  @@map("sub_collections")
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("wishlists")
}

model Review {
  id               String   @id @default(uuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?    @relation(fields: [userId], references: [id])
  userName         String
  rating           Int
  title            String?
  comment          String   @db.Text
  images           String[]
  adminReply       String?  @db.Text
  helpfulCount     Int      @default(0)
  verifiedPurchase Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@map("reviews")
}

enum OrderSource {
  WEBSITE
  WHATSAPP
  INSTAGRAM
  PHONE
  DIRECT_SALE
}

enum OrderType {
  ORDER
  QUOTE
  DRAFT
}

enum OrderTag {
  URGENT
  VIP
  GIFT
  REPLACEMENT
  BULK_ORDER
  INTERNATIONAL
  REPEAT_CUSTOMER
}

enum PaymentMode {
  UPI
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  COD
}

model InvoiceSequence {
  year      Int    @id
  lastValue Int    @default(0)

  @@map("invoice_sequences")
}

model OrderSequence {
  year      Int    @id
  lastValue Int    @default(0)

  @@map("order_sequences")
}

model OrderItem {
  id            String   @id @default(uuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Frozen Product Snapshot & Custom Item Support
  isCustomItem  Boolean  @default(false)
  title         String   @default("Poster Print")
  description   String?
  size          String   @default("A4")
  frame         String   @default("UNFRAMED")
  sku           String?
  productSlug   String?
  thumbnailUrl  String?
  originalPrice Float    @default(0.0)
  price         Float
  printCost     Float    @default(0.0)
  frameCost     Float    @default(0.0)
  unitCost      Float    @default(0.0)
  discount      Float    @default(0.0)
  quantity      Int      @default(1)

  @@map("order_items")
}

model OrderReward {
  id           String   @id @default(uuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rewardType   String   // "COLLECTOR" | "PREMIUM"
  rewardOption String   // e.g., "1xA3", "2xA4", "4xA5", "1xA4_2xA5"
  quantity     Int      @default(1)
  estimatedCost Float   @default(0.0)
  createdAt    DateTime @default(now())

  @@map("order_rewards")
}

model Order {
  id                  String                @id @default(uuid())
  orderNumber         String                @unique
  orderType           OrderType             @default(ORDER)
  orderSource         OrderSource           @default(WEBSITE)
  userId              String?
  user                User?                 @relation(fields: [userId], references: [id])
  email               String
  phone               String?
  
  // Frozen Address Snapshot
  shippingName        String
  shippingStreet      String
  shippingCity        String
  shippingState       String?
  shippingZip         String
  shippingCountry     String                @default("India")

  items               OrderItem[]
  payments            OrderPayment[]
  notesHistory        OrderNote[]
  auditEvents         OrderAuditEvent[]
  attachments         OrderAttachment[]
  invoices            Invoice[]
  rewards             OrderReward[]
  tags                OrderTag[]

  subtotal            Float
  shippingCost        Float                 @default(0.0)
  shippingType        String                @default("Standard")
  discount            Float                 @default(0.0)
  discountType        String?               // "PERCENTAGE" | "FIXED"
  taxAmount           Float                 @default(0.0)
  total               Float
  
  // Enterprise Financial Snapshot Breakdown
  printingCost        Float                 @default(0.0)
  frameCost           Float                 @default(0.0)
  packagingCost       Float                 @default(0.0)
  gatewayFee          Float                 @default(0.0)
  rewardCost          Float                 @default(0.0)
  gstAmount           Float                 @default(0.0)
  totalCost           Float                 @default(0.0)
  netProfit           Float                 @default(0.0)
  profitMargin        Float                 @default(0.0)
  
  paymentMethod       String                @default("UPI")
  paymentReference    String?
  upiTransactionId    String?
  paymentProofImage   String?
  paymentStatus       PaymentStatus         @default(PENDING)
  shippingStatus      ShippingStatus        @default(PENDING)
  
  courierPartner      String?
  awbNumber           String?
  shippingLabelUrl    String?
  paymentVerifiedAt   DateTime?
  inventoryDeductedAt DateTime?
  confirmedByAdminId  String?
  trackingNumber      String?
  estimatedDelivery   DateTime?
  convertedFromQuoteId String?
  notes               String?               @db.Text
  
  statusHistory       OrderStatusHistory[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([orderSource])
  @@index([orderType])
  @@index([paymentStatus])
  @@index([shippingStatus])
  @@index([createdAt])
  @@index([userId])
  @@map("orders")
}

model OrderPayment {
  id             String      @id @default(uuid())
  orderId        String
  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount         Float
  paymentMode    PaymentMode
  transactionRef String?
  paymentProof   String?
  paidAt         DateTime    @default(now())
  notes          String?
  recordedBy     String?

  @@map("order_payments")
}

model Invoice {
  id               String   @id @default(uuid())
  invoiceNumber    String   @unique // POL-2026-000152
  version          Int      @default(1)
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pdfUrl           String?
  subtotal         Float
  discount         Float
  tax              Float
  total            Float
  businessSnapshot Json?    // Frozen company profile at issue time
  issuedAt         DateTime @default(now())

  @@map("invoices")
}

model OrderAuditEvent {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  event       String   // e.g. "PAYMENT_RECORDED", "INVOICE_GENERATED"
  details     String?  @db.Text
  performedBy String   @default("System")
  createdAt   DateTime @default(now())

  @@map("order_audit_events")
}

model OrderNote {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author    String   @default("Admin")
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@map("order_notes")
}

model OrderAttachment {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  url       String
  name      String
  fileType  String
  createdAt DateTime @default(now())

  @@map("order_attachments")
}

model OrderStatusHistory {
  id        String         @id @default(uuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    ShippingStatus
  comment   String?
  createdAt DateTime       @default(now())

  @@map("order_status_histories")
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  VERIFIED
  PAID
  FAILED
}

enum ShippingStatus {
  WHATSAPP_PENDING
  DRAFT
  QUOTE
  PENDING
  CONFIRMED
  PAID
  PRINTED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
  CANCELLED
  EXPIRED
}

model Coupon {
  id           String       @id @default(uuid())
  code         String       @unique
  discountType DiscountType @default(percentage)
  value        Float
  active       Boolean      @default(true)
  expiryDate   DateTime?
  createdAt    DateTime     @default(now())

  @@map("coupons")
}

enum DiscountType {
  percentage
  fixed
}

model NewsletterSubscriber {
  id           String   @id @default(uuid())
  email        String   @unique
  subscribedAt DateTime @default(now())
  isActive     Boolean  @default(true)

  @@map("newsletter_subscribers")
}

model Testimonial {
  id        String   @id @default(uuid())
  quote     String   @db.Text
  author    String
  rating    String   @default("★★★★★")
  createdAt DateTime @default(now())

  @@map("testimonials")
}

model SiteSettings {
  id                       String   @id @default(uuid())
  shippingFee              Float    @default(60.0)
  freeShippingThreshold    Float    @default(499.0)
  collectorRewardThreshold Float    @default(899.0)
  premiumRewardThreshold   Float    @default(1499.0)
  loyaltyPointsRatio       Float    @default(100.0)
  heroTitle                String   @default("Bring Cinema Home.")
  heroSubtitle             String   @default("Premium Malayalam Cinema Posters Crafted For Collectors.")
  rewardsEnabled           Boolean  @default(true)
  limitedEditionsEnabled   Boolean  @default(true)
  instagramUrl             String?
  logo                     String?
  supportEmail             String   @default("support@polacraft.com")
  gstNumber                String?
  maintenanceMode          Boolean  @default(false)

  // Enterprise Variable Unit Expenses (Defaults)
  costA5                   Float    @default(15.0)
  costA4                   Float    @default(28.0)
  costA3                   Float    @default(52.0)
  costA2                   Float    @default(100.0)
  costCanvas               Float    @default(200.0)
  costBlackFrame           Float    @default(120.0)
  costWoodFrame            Float    @default(150.0)
  packagingCostPerOrder    Float    @default(18.0)
  gatewayFeePercent        Float    @default(2.0)
  gstTaxPercent            Float    @default(18.0)
  
  // Polacraft v1.2 AI Settings
  aiEnabled                Boolean  @default(true)
  aiProvider               String   @default("openai")
  aiVisionEnabled          Boolean  @default(true)
  aiMetadataEnabled        Boolean  @default(true)
  aiSocialCaptionsEnabled  Boolean  @default(true)
  aiDefaultTone            String   @default("Collector Focused")
  aiDefaultLanguage        String   @default("English")
  aiMaxDescriptionLength   Int      @default(120)

  // Polacraft Custom Print Studio Live Pricing Controls
  customBasePriceA5        Float    @default(45.0)
  customBasePriceA4        Float    @default(70.0)
  customBasePriceA3        Float    @default(100.0)
  customMultSingle         Float    @default(1.0)
  customMultSplit3         Float    @default(2.5)
  customMultSplit2x2       Float    @default(3.2)
  customMultRetro          Float    @default(1.5)
  customMultPocket         Float    @default(0.8)
  customMultPhotobooth     Float    @default(0.9)
  customFrameAddonA5       Float    @default(155.0)
  customFrameAddonA4       Float    @default(180.0)
  customFrameAddonA3       Float    @default(200.0)

  // Originkit Hero Carousel Controls (shared fallback)
  heroSelectedPosterIds        String[] @default([])
  heroSpeedMobile              Float    @default(4.0)
  heroSpeedDesktop             Float    @default(2.7)
  // Per-view poster selections (override heroSelectedPosterIds when non-empty)
  heroSelectedPosterIdsMobile  String[] @default([])
  heroSelectedPosterIdsDesktop String[] @default([])

  updatedAt                DateTime @updatedAt

  @@map("site_settings")
}

model ExpenseSettingHistory {
  id                    String   @id @default(uuid())
  effectiveFrom         DateTime @default(now())
  costA5                Float    @default(15.0)
  costA4                Float    @default(28.0)
  costA3                Float    @default(52.0)
  costA2                Float    @default(100.0)
  costCanvas            Float    @default(200.0)
  costBlackFrame        Float    @default(120.0)
  costWoodFrame         Float    @default(150.0)
  packagingCostPerOrder Float    @default(18.0)
  gatewayFeePercent     Float    @default(2.0)
  gstTaxPercent         Float    @default(18.0)
  note                  String?
  createdAt             DateTime @default(now())

  @@map("expense_setting_histories")
}

model OperatingExpense {
  id           String   @id @default(uuid())
  title        String
  category     String   // "SUPPLIES" | "MARKETING" | "EQUIPMENT" | "SHIPPING" | "SOFTWARE" | "OTHER"
  amount       Float
  description  String?
  receiptImage String?
  date         DateTime @default(now())
  loggedBy     String   @default("Admin")
  createdAt    DateTime @default(now())

  @@map("operating_expenses")
}

model FixedOverhead {
  id          String   @id @default(uuid())
  name        String   // "Adobe Creative Cloud", "Shopify/Vercel", "Monthly Internet", "Rent"
  category    String   // "SOFTWARE" | "UTILITIES" | "RENT" | "SALARY"
  amount      Float
  frequency   String   @default("MONTHLY") // "MONTHLY" | "ANNUAL"
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("fixed_overheads")
}

model LoyaltyTransaction {
  id          String                 @id @default(uuid())
  userId      String
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  points      Int
  type        LoyaltyTransactionType @default(EARNED)
  description String
  createdAt   DateTime               @default(now())

  @@map("loyalty_transactions")
}

model Promotion {
  id                       String    @id @default(uuid())
  name                     String
  startDate                DateTime
  endDate                  DateTime
  isActive                 Boolean   @default(true)
  freeShippingThreshold    Float?
  collectorRewardThreshold Float?
  premiumRewardThreshold   Float?
  bannerText               String?
  createdAt                DateTime  @default(now())

  @@map("promotions")
}

model AnalyticsEvent {
  id         String   @id @default(uuid())
  type       String   // "Product Viewed", "Search", "Wishlist", "Checkout", "Purchase"
  userId     String?
  sessionId  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([type])
  @@index([createdAt])
  @@map("analytics_events")
}

model JournalPost {
  id          String        @id @default(uuid())
  slug        String        @unique
  title       String
  excerpt     String
  content     String        @db.Text
  img         String
  readTime    String
  publishedAt DateTime?
  authorId    String
  author      Author        @relation(fields: [authorId], references: [id])
  categoryId  String
  category    BlogCategory  @relation(fields: [categoryId], references: [id])
  tags        Tag[]

  @@map("journal_posts")
}

model Author {
  id        String        @id @default(uuid())
  name      String
  avatar    String?
  posts     JournalPost[]

  @@map("authors")
}

model BlogCategory {
  id        String        @id @default(uuid())
  name      String        @unique
  posts     JournalPost[]

  @@map("blog_categories")
}

model Tag {
  id        String        @id @default(uuid())
  name      String        @unique
  posts     JournalPost[]

  @@map("tags")
}
